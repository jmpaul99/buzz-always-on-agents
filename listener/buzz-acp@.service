[Unit]
Description=buzz-acp agent %i
After=network-online.target buzz-litellm-proxy.service
Wants=network-online.target
Requires=buzz-litellm-proxy.service

[Service]
Type=simple
User=root
WorkingDirectory=/var/lib/buzz-listener
EnvironmentFile=-/etc/buzz/_runtime.env
EnvironmentFile=/etc/buzz/%i.env
Environment=PYTHONUNBUFFERED=1
Environment=RUST_LOG=info,buzz_acp=info
ExecStart=/opt/buzz-listener/run-acp.sh %i
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

# Copy to infra/config.env (never commit), or run .\deploy.ps1 from the repo root
# (it seeds this file from .env). Process env overrides these keys.

GCP_PROJECT=your-gcp-project
GCP_REGION=us-central1
GCP_ZONE=us-central1-a
AR_REPO=buzz
LITELLM_SERVICE=litellm-goose
GOOSE_SERVICE=goose-worker
LISTENER_INSTANCE=buzz-listener
LISTENER_SA=buzz-listener
GOOSE_SA=goose-job
LITELLM_SA=litellm-goose
RELAY_URL=wss://your-community.communities.buzz.xyz
IAP_TAG=iap-ssh
# Optional. Empty = buzz-goose-workspace-$GCP_PROJECT in us-central1 (~3 GB target).
WORKSPACE_BUCKET=
